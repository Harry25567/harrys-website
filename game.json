      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "",
            "// Flappy Burst - all gameplay is drawn in this JavaScript event.",
            "// Controls: Space / click / touch = flap. E = energy burst.",
            "// The burst is a non-weapon power-up: it removes the nearest pillar pair.",
            "",
            "if (!runtimeScene.__flappyBurst) {",
            "  const canvas = document.createElement(\"canvas\");",
            "  canvas.width = 800;",
            "  canvas.height = 600;",
            "  canvas.id = \"flappy-burst-canvas\";",
            "  canvas.style.position = \"fixed\";",
            "  canvas.style.left = \"50%\";",
            "  canvas.style.top = \"50%\";",
            "  canvas.style.transform = \"translate(-50%, -50%)\";",
            "  canvas.style.width = \"min(100vw, 800px)\";",
            "  canvas.style.height = \"min(100vh, 600px)\";",
            "  canvas.style.zIndex = \"9999\";",
            "  canvas.style.pointerEvents = \"none\";",
            "  document.body.appendChild(canvas);",
            "",
            "  const ctx = canvas.getContext(\"2d\");",
            "  const S = {",
            "    started: false, gameOver: false, score: 0, best: Number(localStorage.getItem(\"flappyBurstBest\") || 0),",
            "    bird: {x: 190, y: 300, vy: 0, r: 18},",
            "    pipes: [], spawn: 0, burstCharge: 1, burstAnim: 0, time: 0",
            "  };",
            "",
            "  const flap = () => {",
            "    if (!S.started || S.gameOver) {",
            "      S.started = true; S.gameOver = false; S.score = 0; S.spawn = 0;",
            "      S.bird.y = 300; S.bird.vy = 0; S.pipes = []; S.burstCharge = 1;",
            "      for (let i=0;i<3;i++) addPipe(520 + i*270);",
            "    }",
            "    S.bird.vy = -390;",
            "  };",
            "",
            "  const burst = () => {",
            "    if (!S.started || S.gameOver || S.burstCharge < 1) return;",
            "    let target = null, bestX = Infinity;",
            "    for (const p of S.pipes) {",
            "      if (!p.cleared && p.x > S.bird.x && p.x < bestX) { target = p; bestX = p.x; }",
            "    }",
            "    if (target) {",
            "      target.cleared = true;",
            "      target.clearTimer = 0.45;",
            "      S.burstCharge = 0;",
            "      S.burstAnim = 0.35;",
            "    }",
            "  };",
            "",
            "  function addPipe(x) {",
            "    const gap = 175;",
            "    const center = 150 + Math.random()*260;",
            "    S.pipes.push({x, center, gap, scored:false, cleared:false, clearTimer:0});",
            "  }",
            "",
            "  const key = e => {",
            "    if (e.code === \"Space\") { e.preventDefault(); flap(); }",
            "    if (e.code === \"KeyE\") { e.preventDefault(); burst(); }",
            "  };",
            "  window.addEventListener(\"keydown\", key);",
            "  window.addEventListener(\"pointerdown\", e => {",
            "    const rect = canvas.getBoundingClientRect();",
            "    const x = (e.clientX-rect.left) * 800/rect.width;",
            "    const y = (e.clientY-rect.top) * 600/rect.height;",
            "    if (S.gameOver) { flap(); return; }",
            "    if (x > 650 && y > 520) burst(); else flap();",
            "  });",
            "",
            "  runtimeScene.__flappyBurst = {canvas, ctx, S};",
            "}",
            "",
            "const G = runtimeScene.__flappyBurst;",
            "const {ctx, S} = G;",
            "const dt = Math.min(runtimeScene.getElapsedTime()/1000, 0.033);",
            "",
            "S.time += dt;",
            "",
            "if (S.started && !S.gameOver) {",
            "  S.bird.vy += 1050 * dt;",
            "  S.bird.vy = Math.min(S.bird.vy, 650);",
            "  S.bird.y += S.bird.vy * dt;",
            "",
            "  S.spawn += dt;",
            "  if (S.spawn > 1.65) {",
            "    addPipe(840);",
            "    S.spawn = 0;",
            "  }",
            "",
            "  for (const p of S.pipes) {",
            "    if (!p.cleared) p.x -= 230 * dt;",
            "    else { p.x -= 230 * dt; p.clearTimer -= dt; }",
            "    if (!p.scored && p.x + 65 < S.bird.x) {",
            "      p.scored = true; S.score++;",
            "      if (S.score % 5 === 0) S.burstCharge = 1;",
            "    }",
            "  }",
            "  S.pipes = S.pipes.filter(p => p.x > -100);",
            "",
            "  for (const p of S.pipes) {",
            "    if (p.cleared) continue;",
            "    const inX = S.bird.x + S.bird.r > p.x && S.bird.x - S.bird.r < p.x + 70;",
            "    const hitTop = S.bird.y - S.bird.r < p.center - p.gap/2;",
            "    const hitBottom = S.bird.y + S.bird.r > p.center + p.gap/2;",
            "    if (inX && (hitTop || hitBottom)) S.gameOver = true;",
            "  }",
            "  if (S.bird.y - S.bird.r < 0 || S.bird.y + S.bird.r > 550) S.gameOver = true;",
            "",
            "  if (S.gameOver) {",
            "    S.best = Math.max(S.best, S.score);",
            "    localStorage.setItem(\"flappyBurstBest\", String(S.best));",
            "  }",
            "}",
            "",
            "function roundedRect(x,y,w,h,r) {",
            "  ctx.beginPath();",
            "  ctx.roundRect(x,y,w,h,r);",
            "  ctx.fill();",
            "}",
            "",
            "function draw() {",
            "  // sky",
            "  const grd = ctx.createLinearGradient(0,0,0,600);",
            "  grd.addColorStop(0,\"#67c7ff\"); grd.addColorStop(1,\"#d7f5ff\");",
            "  ctx.fillStyle = grd; ctx.fillRect(0,0,800,600);",
            "",
            "  // clouds",
            "  ctx.fillStyle = \"rgba(255,255,255,.75)\";",
            "  for (const c of [{x:90,y:100,s:1},{x:470,y:150,s:.8},{x:690,y:75,s:.6}]) {",
            "    ctx.beginPath();",
            "    ctx.arc(c.x,c.y,28*c.s,0,Math.PI*2);",
            "    ctx.arc(c.x+30*c.s,c.y+5*c.s,22*c.s,0,Math.PI*2);",
            "    ctx.arc(c.x-25*c.s,c.y+8*c.s,19*c.s,0,Math.PI*2);",
            "    ctx.fill();",
            "  }",
            "",
            "  // pipes",
            "  for (const p of S.pipes) {",
            "    if (p.cleared) continue;",
            "    ctx.fillStyle = \"#45a844\";",
            "    ctx.fillRect(p.x,0,70,p.center-p.gap/2);",
            "    ctx.fillRect(p.x,p.center+p.gap/2,70,550-(p.center+p.gap/2));",
            "    ctx.fillStyle = \"#62c95b\";",
            "    ctx.fillRect(p.x-7,p.center-p.gap/2-18,84,18);",
            "    ctx.fillRect(p.x-7,p.center+p.gap/2,84,18);",
            "  }",
            "",
            "  // ground",
            "  ctx.fillStyle = \"#e8c35a\"; ctx.fillRect(0,550,800,50);",
            "  ctx.fillStyle = \"#72b84c\"; ctx.fillRect(0,550,800,12);",
            "",
            "  // bird",
            "  ctx.save();",
            "  ctx.translate(S.bird.x,S.bird.y);",
            "  ctx.rotate(Math.max(-0.45,Math.min(1.0,S.bird.vy/700)));",
            "  ctx.fillStyle = \"#ffd43b\"; ctx.beginPath(); ctx.arc(0,0,18,0,Math.PI*2); ctx.fill();",
            "  ctx.fillStyle = \"#f39c12\"; ctx.beginPath(); ctx.moveTo(12,0); ctx.lineTo(31,7); ctx.lineTo(12,11); ctx.closePath(); ctx.fill();",
            "  ctx.fillStyle = \"#fff\"; ctx.beginPath(); ctx.arc(7,-7,6,0,Math.PI*2); ctx.fill();",
            "  ctx.fillStyle = \"#222\"; ctx.beginPath(); ctx.arc(9,-7,2.5,0,Math.PI*2); ctx.fill();",
            "  ctx.fillStyle = \"#e9a72c\"; ctx.beginPath(); ctx.ellipse(-5,8,11,6,0,0,Math.PI*2); ctx.fill();",
            "  ctx.restore();",
            "",
            "  // burst animation",
            "  if (S.burstAnim > 0) {",
            "    const a = S.burstAnim / 0.35;",
            "    ctx.strokeStyle = `rgba(120,240,255,${a})`;",
            "    ctx.lineWidth = 8;",
            "    ctx.beginPath(); ctx.arc(S.bird.x,S.bird.y,70+(1-a)*170,0,Math.PI*2); ctx.stroke();",
            "  }",
            "",
            "  ctx.fillStyle = \"#fff\"; ctx.strokeStyle = \"#1d3557\"; ctx.lineWidth = 5;",
            "  ctx.font = \"bold 46px Arial\"; ctx.textAlign = \"center\";",
            "  ctx.strokeText(String(S.score),400,65); ctx.fillText(String(S.score),400,65);",
            "",
            "  ctx.textAlign = \"left\"; ctx.font = \"bold 20px Arial\";",
            "  ctx.fillStyle = \"#17324d\"; ctx.fillText(`BEST: ${S.best}`,20,35);",
            "  ctx.fillText(`BURST: ${S.burstCharge ? \"READY\" : \"CHARGING\"}`,20,62);",
            "",
            "  if (!S.started) {",
            "    ctx.fillStyle = \"rgba(0,0,0,.38)\"; ctx.fillRect(0,0,800,550);",
            "    ctx.fillStyle = \"#fff\"; ctx.textAlign = \"center\";",
            "    ctx.font = \"bold 48px Arial\"; ctx.fillText(\"FLAPPY BURST\",400,210);",
            "    ctx.font = \"24px Arial\"; ctx.fillText(\"SPACE / CLICK = FLAP\",400,270);",
            "    ctx.fillText(\"E = ENERGY BURST (clears 1 pillar)\",400,305);",
            "    ctx.font = \"bold 28px Arial\"; ctx.fillText(\"CLICK TO START\",400,370);",
            "  }",
            "",
            "  if (S.gameOver) {",
            "    ctx.fillStyle = \"rgba(0,0,0,.45)\"; ctx.fillRect(0,0,800,550);",
            "    ctx.fillStyle = \"#fff\"; ctx.textAlign = \"center\";",
            "    ctx.font = \"bold 52px Arial\"; ctx.fillText(\"GAME OVER\",400,245);",
            "    ctx.font = \"28px Arial\"; ctx.fillText(`Score: ${S.score}   Best: ${S.best}`,400,295);",
            "    ctx.fillText(\"CLICK or SPACE TO RESTART\",400,350);",
            "  }",
            "}",
            "S.burstAnim = Math.max(0, S.burstAnim - dt);",
            "draw();"
          ],
          "useStrict": false,
          "eventsSheetExpanded": true
        }
      ],
